# Скопируйте в .env. В разработке значения по умолчанию подходят как есть.
DATABASE_URL=postgresql://hydrocrm:hydrocrm@localhost:5433/hydrocrm
PORT=3000
# Длинная случайная строка, на сервере обязательно своя: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me
# Песочница для портфолио: вход по ролям без пароля, ночной сброс демо-данных (docs/01-архитектура.md, раздел 13)
DEMO_MODE=false
# Папка для загруженных файлов в разработке
UPLOADS_DIR=../../.data/uploads
# Адрес интерфейса (CORS в разработке)
WEB_ORIGIN=http://localhost:5173
