{
  "name": "hydrocrm",
  "private": true,
  "version": "0.1.0",
  "description": "ГидроCRM — CRM для сервиса по ремонту и сборке гидростанций",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db": "node scripts/dev-db.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @hydrocrm/api prisma:migrate",
    "db:seed": "pnpm --filter @hydrocrm/api seed",
    "db:demo": "pnpm --filter @hydrocrm/api seed:demo",
    "demo:export": "pnpm --filter @hydrocrm/api export:demo",
    "build:demo": "node scripts/build-demo.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "pg": "8.13.1",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2"
  }
}
